flowchart TB
  client([Client]):::ext
  obs["observe_http_traffic (wraps every data-plane route)<br/>classify route_class · count request + response body frames"]:::new
  sp["route_ecw_service_port_requests"]:::old
  h["Handlers: filesystem · process · native sessions · service proxy"]:::old
  wf["ECW POST /files<br/>resolve route → UploadTracker.begin(org_id, sandbox_id)"]:::new
  sandbox([Sandbox service]):::ext

  client -- "request / response bodies" --> obs
  obs --> sp --> h
  sp --> wf
  h -. "relayed responses marked sandbox_service" .-> sandbox

  obs ==> m1["data_plane.http.bytes{direction, route_class}<br/>flush every 1 MiB and on drop"]:::metric
  obs ==> m2["data_plane.http.too_many_requests{route_class, reason}<br/>reason from response extension, else unclassified"]:::metric
  wf ==> m3["data_plane.upload.in_flight / in_flight_bytes<br/>changed and emitted under one lock"]:::metric
  wf ==> l1["log space.data_plane.upload<br/>org_id · sandbox_id · outcome · bytes received / reserved · duration"]:::log

